{
  "framework": null,
  "buildCommand": "npm run build && npm run check",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "estimate.heritagecce.com"
        }
      ],
      "destination": "/estimate/",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "estimate.heritagecce.com"
        }
      ],
      "destination": "https://heritage-cce.vercel.app/staff/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "estimate.heritagecce.com"
        }
      ],
      "destination": "https://heritage-cce.vercel.app/staff/",
      "permanent": false
    },
    {
      "source": "/staff",
      "has": [
        {
          "type": "host",
          "value": "estimate.heritagecce.com"
        }
      ],
      "destination": "https://heritage-cce.vercel.app/staff/",
      "permanent": false
    },
    {
      "source": "/staff/:path*",
      "has": [
        {
          "type": "host",
          "value": "estimate.heritagecce.com"
        }
      ],
      "destination": "https://heritage-cce.vercel.app/staff/",
      "permanent": false
    },
    {
      "source": "/estimate/continue/:token",
      "has": [
        {
          "type": "host",
          "value": "estimate.heritagecce.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/confirmation/:reference",
      "has": [
        {
          "type": "host",
          "value": "estimate.heritagecce.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/check-status",
      "has": [
        {
          "type": "host",
          "value": "estimate.heritagecce.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/staff/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/staff/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/estimate/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
